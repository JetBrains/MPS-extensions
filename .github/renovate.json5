{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": ["org.eclipse.emf:*", "org.eclipse.xtext:*"],
      "matchFileNames": ["code/platform/build.gradle.kts"],
      "matchBaseBranches": ["maintenance/mps20241"],
      "enabled": false
    },
    {
      "matchPackageNames": ["net.sourceforge.plantuml:plantuml"],
      "matchFileNames": ["code/platform/build.gradle.kts"],
      "allowedVersions": "< 2000"
    }
  ]
}
